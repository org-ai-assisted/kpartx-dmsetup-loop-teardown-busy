+	/*
+	 * Hold the exclusive BSD lock on the whole-disk device while partition
+	 * maps are added or removed, per the systemd block-device locking
+	 * protocol: udev takes a shared lock before probing a device, so holding
+	 * LOCK_EX here makes udev defer instead of racing kpartx.  A udev/blkid
+	 * probe that opens a partition during teardown is exactly what leaves a
+	 * partition map busy or stale.  Released implicitly when fd is closed.
+	 * Best-effort: never fail kpartx on a backend that does not support it.
+	 */
+	if (what != LIST && flock(fd, LOCK_EX) < 0)
+		fprintf(stderr, "%s: warning: could not take block-device lock: %s\n",
+			device, strerror(errno));

+/*
+ * A remove that fails because the device is still open is the common
+ * "Device or resource busy" case.  The bare ioctl error carries no open
+ * count and no holder, so a transient opener looks like a device that needs
+ * a reboot.  Report the open count and, mirroring lv_check_not_in_use(),
+ * distinguish a stacked block-device holder (nameable via sysfs) from an
+ * opener with no block holder (a process fd, a mount in any namespace, or
+ * swap).  Resolves the name via dm_task_get_name() so it also covers removal
+ * by --uuid / --major+--minor.  Self-guards: logs only when the device is
+ * still present and open.
+ */
+static void _explain_remove_busy(const char *name)
+{
+	struct dm_task *dmt;
+	struct dm_info info;
+	const char *dname;
+
+	if (!(dmt = dm_task_create(DM_DEVICE_INFO)))
+		return;
+
+	/* optional=1: the remove already reported a no-selector case, so stay
+	 * silent here rather than repeat "No device specified". */
+	if (_set_task_device(dmt, name, 1) &&
+	    dm_task_run(dmt) &&
+	    dm_task_get_info(dmt, &info) &&
+	    info.exists && info.open_count > 0) {
+		if (!(dname = dm_task_get_name(dmt)) || !*dname)
+			dname = name ? name : "device";
+
+		if (dm_device_has_holders(info.major, info.minor))
+			log_error("device-mapper: remove of %s is blocked: still open "
+				  "(open count %d) by a stacked block device -- see "
+				  "/sys/dev/block/%u:%u/holders; remove the holder first.",
+				  dname, info.open_count, info.major, info.minor);
+		else
+			/* dm_device_has_holders() returns 0 both for no holder and for an
+			 * unreadable sysfs, so phrase this as "not found", never a
+			 * definitive absence. */
+			log_error("device-mapper: remove of %s is blocked: still open "
+				  "(open count %d). No stacked block-device holder was found in "
+				  "/sys/dev/block/%u:%u/holders, so the opener is most likely a "
+				  "process fd, a mount in any namespace, or swap -- close it "
+				  "(fuser/lsof the node; scan /proc/*/fd and /proc/*/mountinfo "
+				  "across namespaces), then retry; or use 'remove --deferred' to "
+				  "remove on last close. 'remove --force' only loads the error "
+				  "target and cannot remove an open device.",
+				  dname, info.open_count, info.major, info.minor);
+	}
+
+	dm_task_destroy(dmt);
+}
+
 static int _remove(CMD_ARGS)
 {
+	int r;
+
 	if (_switches[FORCE_ARG] && argc) {
 		/*
 		 * 'remove --force' option is doing 2 operations on the same device
@@ -2289,7 +2343,14 @@ static int _remove(CMD_ARGS)
 		(void) _error_device(cmd, NULL, argc, argv, NULL, 0);
 	}

-	return _simple(DM_DEVICE_REMOVE, argc ? argv[0] : NULL, 0, 0);
+	r = _simple(DM_DEVICE_REMOVE, argc ? argv[0] : NULL, 0, 0);
+
+	/* Only on the failure path: a successful remove (incl. --deferred, which
+	 * succeeds and leaves the device present) must not look "blocked". */
+	if (!r)
+		_explain_remove_busy(argc ? argv[0] : NULL);
+
+	return r;
 }

